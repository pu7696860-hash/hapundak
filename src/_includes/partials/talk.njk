{#- תגובות שאושרו (מתוך src/_data/comments.json, נערך במסך העריכה). מזהים יצירה לפי "שם (כותבת)", כי יש יצירות עם אותו שם -#}
{%- set talkKey = talkTitle + " (" + author + ")" -%}
{%- set approved = [] -%}
{%- for c in comments.items -%}{%- if c.piece == talkKey -%}{%- set _p = approved.push(c) -%}{%- endif -%}{%- endfor -%}
<div class="talk" id="comments"><div class="talk-h"><h4>תגובות</h4><span>מתפרסמות אחרי אישור העורכת</span></div>
 {% if approved | length %}<div class="talk-list">{% for c in approved %}<div class="tc"><b>{{ c.name }}</b><p>{{ c.text }}</p></div>{% endfor %}</div>{% endif %}
 <p class="praise-note" hidden>💛 כותבות פרגון{% if author %} ל{{ author }}{% endif %}. כמה מילים טובות עושות הרבה.</p>
 <form class="form fly-form" data-kind="comment" data-page="{{ talkTitle }}" action="https://formsubmit.co/{{ site.email }}" method="POST">
  <input type="hidden" name="_subject" value="תגובה חדשה">
  <input type="hidden" name="_next" value="">
  <input type="hidden" name="_captcha" value="false">
  <input type="hidden" name="_template" value="table">
  <input type="hidden" name="העמוד" value="{{ talkTitle }}">
  <input type="hidden" name="הכותבת" value="{{ author }}">
  <input type="hidden" name="כתובת העמוד" value="">
  <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label class="full">שם או כינוי<input name="שם" required placeholder="איך לקרוא לך?"></label>
  <label class="full">התגובה שלך<textarea name="תגובה" rows="4" required placeholder="מה הרגשת כשקראת?"></textarea></label>
  <label class="chk full"><input type="checkbox" class="cc-author" name="להעביר לכותבת" value="כן, נא להעביר את התגובה גם לכותבת"> אני רוצה להעביר גם לכותבת!</label>
  <div class="full sendwrap"><button class="send" type="submit"><span class="fill"></span><span class="t">שליחת תגובה</span><span class="done">התגובה נשלחה ✓</span></button></div>
  <p class="ok" hidden>תודה! התגובה הגיעה אל העורכת 💛</p>
  <p class="err" hidden></p>
  <p class="fallback">הטופס לא נשלח אצלך? אפשר לשלוח את התגובה במייל: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
 </form>
 <p class="talk-note">🔒 התגובות מגיעות אל העורכת, ומתפרסמות לאחר אישור</p>
</div>
